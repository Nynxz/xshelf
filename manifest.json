{
  "manifest_version": 3,
  "name": "X Bookmark Downloader",
  "version": "1.0.0",
  "description": "Backs up your X/Twitter bookmarks (text, full-res images, videos, metadata) to disk. Read-only — never modifies your bookmarks.",
  "permissions": [
    "downloads",
    "storage",
    "unlimitedStorage",
    "webRequest"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.x.com/*",
    "https://api.twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Bookmark Downloader"
  }
}
