{
  "name": "x-bookmark-downloader",
  "version": "0.2.0",
  "private": true,
  "description": "Browser extension that backs up X/Twitter bookmarks (text, full-res media, metadata) and renders a local explorer.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/chrome": "^0.0.270",
    "typescript": "^5.5.0",
    "wxt": "^0.19.0"
  }
}
