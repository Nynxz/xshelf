{
  "name": "xshelf",
  "version": "0.3.0",
  "private": true,
  "description": "Browser extension that backs up X/Twitter bookmarks (text, full-res media, metadata) and renders a local explorer.",
  "type": "module",
  "scripts": {
    "dev": "npm run build:snapshot && wxt",
    "dev:firefox": "npm run build:snapshot && wxt -b firefox",
    "build": "npm run build:snapshot && wxt build",
    "build:firefox": "npm run build:snapshot && wxt build -b firefox",
    "build:snapshot": "wxt prepare && vite build -c vite.snapshot.config.ts",
    "zip": "npm run build:snapshot && wxt zip",
    "zip:firefox": "npm run build:snapshot && wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/chrome": "^0.0.270",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.3",
    "wxt": "^0.19.0"
  }
}
